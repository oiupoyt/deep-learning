{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "outDir": "lib/tests",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src/tests/**/*", "src/index.ts"],
  "exclude": ["lib/**/*", "node_modules"]
}
